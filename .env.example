# Kunci induk. Satu-satunya yang boleh mendaftarkan dan mencabut aplikasi.
# Terbitkan dengan: make key
ADMIN_KEY=ganti-ini-minimal-32-karakter-acak

# Satu folder untuk seluruh keadaan servis: stock.db dan files/.
# Satu folder, bukan dua, supaya pencadangan tidak bisa setengah.
STORAGE_DIR=storage

# Batas ukuran satu berkas, dalam megabyte. Video ikut, jadi bawaannya besar.
MAX_UPLOAD_MB=200

# Berapa lama berkas konten yang SUDAH SELESAI disimpan sebelum dibuang.
# "Selesai" berarti sudah tayang atau sudah dibatalkan. Stok yang masih
# menunggu gilirannya tidak pernah disentuh, berapa lama pun sudah diunggah.
# Yang dibuang cuma berkasnya — baris, jadwal, dan riwayatnya tetap.
# Diisi 0 berarti tidak pernah dibuang.
RETENTION_DAYS=90

# Berapa lama konten boleh dipegang satu aplikasi sebelum claimnya dilepas.
# Integrator yang mati sesudah mengclaim membuat kontennya diam selamanya.
# Jangan terlalu pendek: yang masih mengunggah video besar bisa direbut
# aplikasi lain, dan kontennya tayang dua kali. Diisi 0 berarti tidak pernah.
CLAIM_TIMEOUT_HOURS=2

# Alamat panel web yang boleh memanggil servis ini, dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000

# Jaringan tempat proxy (nginx) berada. HANYA dari sini header alamat asli
# dipercaya — tanpa ini, servis di balik nginx melihat 127.0.0.1 untuk semua
# permintaan dan seluruh integrator berbagi satu jatah pembatas laju.
# Jangan diperluas tanpa alasan: siapa pun di dalam jaringan yang dipercaya
# bisa mengarang alamatnya sendiri dan mendapat jatah tak terbatas.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

ADDRESS=:8080
