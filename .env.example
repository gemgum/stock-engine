# Kunci induk. Satu-satunya yang boleh mendaftarkan dan mencabut aplikasi.
# Terbitkan dengan: make key
ADMIN_KEY=ganti-ini-minimal-32-karakter-acak

# Satu folder untuk seluruh keadaan servis: stock.db dan files/.
# Satu folder, bukan dua, supaya pencadangan tidak bisa setengah.
STORAGE_DIR=storage

# Batas ukuran satu berkas, dalam megabyte. Video ikut, jadi bawaannya besar.
MAX_UPLOAD_MB=200

# Alamat panel web yang boleh memanggil servis ini, dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000

ADDRESS=:8080
